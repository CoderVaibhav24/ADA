# The build context for every service image is backend/, not the service
# directory: api and ml install shared/ada-core and shared/ada-platform-sdk
# from source, which a context of backend/<service> could not see. Docker reads
# only the .dockerignore at the root of the context, so this one file covers
# all four builds.
#
# Each image then COPYs only what it needs, so anything listed here is
# unreachable from a Dockerfile by construction.

# Python build and test artefacts
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/

# Test suites. The images run no tests; shipping them only invalidates layers.
**/tests/

# Training code and configs — a research tree, not part of the serving image.
ml/training/

# Secrets. .env is gitignored, but a build context is not a git checkout, and
# an .env copied into a layer is readable by anyone who can pull the image.
.env
.env.*
!.env.example

# Documentation and editor state — no image needs them, and they invalidate the
# build cache on every edit.
*.md
!*/README.md
.DS_Store
.vscode/
.idea/
