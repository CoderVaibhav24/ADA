# ── Secrets ──────────────────────────────────────────────────
#
# The glob matters as much as the bare name: .env.local and .env.production
# hold the same credentials, and a bare `.env` rule catches neither. The real
# env file now lives beside the compose file it feeds (infra/compose/.env); the
# committed template is re-admitted below.
.env
.env.*
!.env.example
!infra/compose/.env.example

# Everything infra/scripts/ generates.
#
# `.env.*` above already catches the timestamped backups gen-env.mjs writes
# (infra/compose/.env.backup.<ISO8601>), because those are literally `.env.` plus a
# suffix. The two below are NOT caught by any rule above, and both matter:
#
#   infra/secrets/    create_users.py writes user-credentials-<UTC>.txt here,
#                     mode 0600 — one line per person, credential in the clear.
#   infra/users.yaml  the real roster. It holds no credential, but it is a list
#                     of real names, addresses and phone numbers, which is
#                     personal data and does not belong in a repository.
#
# The committed templates are re-admitted immediately after, so the examples
# stay in git and only the real files stay out.
infra/secrets/
infra/users.yaml
!infra/users.example.yaml

# ── Python ───────────────────────────────────────────────────
.venv/
**/.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ── Node ─────────────────────────────────────────────────────
#
# Repo-wide, not apps/web/-specific: there are two Vite projects (the console
# and apps/keycloak-theme/) and a path-anchored rule silently fails to
# cover the second. apps/keycloak-theme/node_modules alone is 3,381 files
# and carries platform-specific binaries plus a Maven cache full of jars.
node_modules/
dist/
# Keycloakify's output: two theme jars, rebuilt by
# `npm run build-keycloak-theme`. infra/compose/docker-compose.yml bind-mounts one of
# them, so it has to exist locally — it does not have to be in git.
dist_keycloak/
*.tsbuildinfo
.eslintcache

# ── Data (uploads, COGs, masks, weights, samples) ────────────
#
# Spelled out rather than a bare `data/`: git does not descend into an excluded
# directory, so a `!data/weights/manifest.json` under `data/` would never be
# reached. Excluding the contents instead, and re-admitting one path at a time,
# is what makes the negation work.
data/*
!data/weights/
data/weights/*
# The weight manifest is the reproducibility record: it pins the exact upstream
# commit of every vendored model, so `fetch_weights.py` can rebuild an
# identical data/weights/ on any machine. Keep it in version control.
!data/weights/manifest.json

# ── Docs build output ────────────────────────────────────────
#
# docs/ itself IS tracked — the sources and the BA pack are the deliverable.
# Only the generated intermediates are not: regenerate with
# `docs/pdf-build/build.sh`.
docs/pdf-build/build/

# ── Local scratch / non-project artifacts ────────────────────
/Test/
/SS/
/Agra Scope of Work.pdf
/ADA_Vision_Project_Documentation.docx

# ── Docker ───────────────────────────────────────────────────
infra/compose/docker-compose.override.yml

