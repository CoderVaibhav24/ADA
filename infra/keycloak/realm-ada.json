    {
      "name": "notify:send",
      "description": "Permits a project service account to submit notifications to ada-notify (FR-SVC-002). The client scope name IS the OAuth scope value.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
