{
  "realm": "pcsmcpl",
  "displayName": "PCS MCPL",
  "roles": {
    "realm": [
      {
        "name": "super-admin",
        "description": "Administration: users, zones, lookup values. Holds no ICMS case transition - see app/icms/workflow.py."
      },
      {
        "name": "pcs-nodal-officer",
        "description": "ICMS: assigns cases, verifies inspections, decides re-surveys, hands over to the authority."
      },
      {
        "name": "field-surveyor",
        "description": "ICMS: checks in, captures evidence, records findings and submits, on cases assigned to them."
      },
      {
        "name": "ada-project-lead",
        "description": "ICMS: confirms a handover, issues a notice, closes a case."
      }
    ]
  },
  "displayNameHtml": "<strong>PCS MCPL</strong>",
  "enabled": true,
  "sslRequired": "external",
  "organizationsEnabled": false,
  "userManagedAccessAllowed": false,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "requiredCredentials": [
    "password"
  ],
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 7776000,
  "clientOfflineSessionIdleTimeout": 0,
  "clientOfflineSessionMaxLifespan": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 3600,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 900,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "passwordPolicy": "forceExpiredPasswordChange(90) and length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and passwordHistory(5)",
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "contentSecurityPolicyReportOnly": "",
    "referrerPolicy": "no-referrer",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "xRobotsTag": "none",
    "xXSSProtection": "1; mode=block"
  },
  "smtpServer": {
    "host": "${KC_SMTP_HOST:localhost}",
    "port": "${KC_SMTP_PORT:587}",
    "from": "${KC_SMTP_FROM:ada@pcsmcpl.net}",
    "fromDisplayName": "${KC_SMTP_FROM_DISPLAY_NAME:ADA}",
    "ssl": "${KC_SMTP_SSL:false}",
    "starttls": "${KC_SMTP_STARTTLS:true}",
    "auth": "true",
    "user": "${KC_SMTP_USERNAME:}",
    "password": "${KC_SMTP_PASSWORD:}"
  },
  "attributes": {
    "adminEventsExpiration": "7776000",
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "120",
    "cibaInterval": "5",
    "cibaAuthRequestedUserHint": "login_hint",
    "parRequestUriLifespan": "60",
    "realmReusableOtpCode": "false"
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
