# ============ ADA Change Detection — environment ============
# Copy to .env and fill in real secrets. NEVER commit .env.
#
# Generate every secret below with:  openssl rand -hex 32

# --- PostgreSQL (one instance, three databases) ---
# `ada` is the application's, created by the image from POSTGRES_DB.
# `keycloak` and `ada_notify` are created by infra/init-db.sh on FIRST boot
# only — changing their names against a populated volume does nothing until the
# ada_pgdata volume is removed.
POSTGRES_USER=ada_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ada
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_NOTIFY_DB=ada_notify
# Read by ada-api and ada-ml. Inside compose both override this with the
# in-network address; this value stays valid for running either on the host.
DATABASE_URL=postgresql+psycopg2://ada_admin:change-me@localhost:5433/ada
# ada-notify, and ONLY ada-notify. Its schema is separate from ADA's, and the
# asyncpg driver is mandatory — a psycopg URL here produces 'MissingGreenlet'
# deep inside the first request, which is an unreadable way to learn about a typo.
ADA_NOTIFY_DATABASE_URL=postgresql+asyncpg://ada_admin:change-me@localhost:5433/ada_notify
# Optional: give Keycloak its own role instead of the superuser. Leave unset for
# the simple shared arrangement; set both to separate the credentials.
# KC_DB_USERNAME=keycloak
# KC_DB_PASSWORD=change-me

# --- Redis (one-time codes, and the notification broker) ---
REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6379
# Only needed if REDIS_PASSWORD contains a character that is special in a URL
# (@ : / ? # %) — it must be percent-encoded, and the symptom of not doing it is
# a connection error naming the wrong host rather than a bad password.
# ADA_REDIS_URL=redis://:change-me@localhost:6379/0

# --- Keycloak (the identity plane) ---
# A temporary bootstrap admin, created in the master realm on FIRST start only.
# Replace it with a named account and drop these before this stack is anything
# but local.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_HTTP_PORT=8090
KC_HTTP_HOST_PORT=8090
KC_HOSTNAME=http://localhost:5173/idp
# Keycloak is reverse-proxied under the app's origin, so it serves
# everything below this path. NOT /auth: the console already routes
# /auth/callback and /auth/signed-out.
KC_HTTP_RELATIVE_PATH=/idp
KC_MANAGEMENT_PORT=9000
ADA_REALM=pcsmcpl

# The PUBLIC issuer: whatever Keycloak was told to call itself, and therefore
# what it stamps into the 'iss' claim of every token. Compared character for
# character — a trailing slash here and not there is a blanket 401 with no
# useful diagnostic.
ADA_ISSUER=http://localhost:5173/idp/realms/pcsmcpl
# Where that same issuer actually ANSWERS from inside the compose network.
# Discovery and JWKS are fetched from this; the string above is compared.
# Leave unset when running a service on the host, where the two are the same.
ADA_INTERNAL_ISSUER_URL=http://keycloak:8090/idp/realms/pcsmcpl

# Client secrets. These are substituted into keycloak/realm-ada.json at import,
# which happens on first start ONLY — a wrong value is baked into the database
# and correcting it here afterwards changes nothing until the volume is gone.
#
# ada-auth's service account holds realm-management 'impersonation', so its
# secret is as sensitive as an admin password: anything holding it can mint a
# token for any account in the realm.
ADA_AUTH_CLIENT_SECRET=change-me
ADA_NOTIFY_CLIENT_SECRET=change-me
ADA_ML_CLIENT_SECRET=change-me

# Social sign-in. Optional, and DISABLED in the realm until these are set —
# an enabled provider with no credentials puts a button on the login page
# that can only fail. Register these redirect URIs when you create the apps:
#   Google  http://localhost:8091/realms/pcsmcpl/broker/google/endpoint
#   GitHub  http://localhost:8091/realms/pcsmcpl/broker/github/endpoint
# Then enable the provider in the Keycloak admin console, or re-create the
# realm. Leave blank to use username/password and phone+OTP only.
ADA_GOOGLE_CLIENT_ID=
ADA_GOOGLE_CLIENT_SECRET=
ADA_GOOGLE_HOSTED_DOMAIN=
ADA_GITHUB_CLIENT_ID=
ADA_GITHUB_CLIENT_SECRET=

# --- ada-auth (phone + one-time code) ---
ADA_ENV=local
ADA_LOG_LEVEL=INFO
ADA_AUTH_PORT=8002
# The stored value is HMAC-SHA256(key, phone:otp), never the code itself. No
# usable default: an empty key degrades every stored code to a keyed hash with a
# known key, which is not a hash at all.
ADA_OTP_HMAC_KEY=change-me
# console  logs the code at WARNING and sends nothing. The local default, and
#          what makes a clean checkout produce a working OTP login.
# stub     accepts and drops. For tests.
# twofactor  2factor.in, the provider HRMS uses.
ADA_SMS_PROVIDER=console
ADA_TWOFACTOR_API_KEY=
ADA_TWOFACTOR_TEMPLATE=OTP1
# The Keycloak user attribute holding the phone number. Digits only, no '+' and
# no spaces — a number stored as "+91 99900 01234" is not found by a search for
# "919990001234", and the symptom is an unregistered-number response for an
# account that plainly exists.
ADA_OTP_PHONE_ATTRIBUTE=phoneNumber
# false answers identically whether or not a number is registered, which is what
# stops anyone probing which numbers exist. true gives the friendlier 404.
ADA_OTP_REVEAL_UNKNOWN_PHONE=false
# In ADA_ENV=local the issued code is always this value. Production cannot
# enable the bypass with or without the flag.
ADA_DEV_OTP=000000
ADA_ALLOW_OTP_DEV_BYPASS=false

# --- ada-auth: email one-time codes ---
# console  log the code at WARNING and send nothing. Local default.
# stub     accept and drop. For tests.
# smtp     a real relay. Defaults below point at mailpit (http://localhost:8025),
#          so a clean checkout can sign in by email with no mail account.
#
# Deliberately ada-auth's OWN relay rather than ada-notify's: a one-time code is
# worthless in five minutes, and ada-notify is an outbox whose retry ladder is
# measured in minutes. See services/ada-auth/app/email/smtp.py.
ADA_EMAIL_OTP_PROVIDER=smtp
ADA_AUTH_SMTP_HOST=mailpit
ADA_AUTH_SMTP_PORT=1025
ADA_AUTH_SMTP_USERNAME=
ADA_AUTH_SMTP_PASSWORD=
ADA_AUTH_SMTP_STARTTLS=false
ADA_AUTH_SMTP_SSL=false
ADA_AUTH_EMAIL_FROM=ada@pcsmcpl.net
ADA_AUTH_EMAIL_FROM_NAME=ADA
# Same argument as ADA_OTP_REVEAL_UNKNOWN_PHONE, and more pressing: an address
# is easier to guess than a number.
ADA_OTP_REVEAL_UNKNOWN_EMAIL=false

# --- ada-notify / ada-worker ---
ADA_NOTIFY_PORT=8001
ADA_REQUIRED_SCOPE=notify:send
# smtp sends real mail. stub accepts and discards. failing_stub refuses every
# message on purpose, which is how the retry ladder and the dead-letter queue
# are demonstrated.
ADA_EMAIL_PROVIDER=smtp
# Defaults point at the mailpit container, so a clean checkout delivers a real,
# inspectable email at http://localhost:8025 with no external account.
ADA_SMTP_HOST=mailpit
ADA_SMTP_PORT=1025
ADA_SMTP_USERNAME=
ADA_SMTP_PASSWORD=
# Mailpit speaks plain SMTP on 1025 and refuses STARTTLS. A real relay needs
# this true — leaving it false against one sends the password in clear, so the
# host and this flag must be changed together.
ADA_SMTP_STARTTLS=false
ADA_SMTP_SSL=false
ADA_EMAIL_FROM=ada@pcsmcpl.net
ADA_EMAIL_FROM_NAME=ADA
ADA_ADMIN_CLIENT_ID=ada-notify
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
# Keycloak's own realm mail (password reset, address verification). Same relay.
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=ada@pcsmcpl.net
KC_SMTP_FROM_DISPLAY_NAME=ADA
KC_SMTP_USERNAME=
KC_SMTP_PASSWORD=
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false

# --- ada-api ---
BACKEND_PORT=8000
# The public browser client in the realm. A PKCE public client holds no secret.
OIDC_CLIENT_ID=ada-web
# nginx serves the built frontend and proxies /api to ada-api, so the browser
# sees a single origin.
APP_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173

# --- ada-ml ---
ML_PORT=8100
ML_SERVICE_URL=http://ada-ml:8100
# Presented by ada-api on X-ADA-Service-Token and checked by ada-ml. Empty
# disables the check — acceptable on a loopback-only local run, wrong anywhere
# the network is shared, because "run this job id" is an expensive instruction.
ML_SERVICE_TOKEN=change-me
LOG_LEVEL=INFO
# Emit the analysis-complete / analysis-failed notifications. Set false on a
# deployment with no ada-notify, so a finished analysis is not trailed by a
# warning nobody can act on.
NOTIFY_ENABLED=true
NOTIFY_URL=http://ada-notify:8001
NOTIFY_CLIENT_ID=ada-ml
# First boot only: vendor the model weights (~1.5 GB) into ./data/weights and
# generate the synthetic Agra demo pair into ./data/samples. Set false to skip.
AUTO_FETCH_WEIGHTS=true
AUTO_SAMPLE_DATA=true

# --- Storage ---
# Optional — defaults to <repo>/data on any OS if left unset. Only set this if
# you want data stored somewhere outside the repo. Use forward slashes even on
# Windows (e.g. C:/Vaibhav/ADA/data), or an absolute POSIX path on Linux/macOS.
# DATA_DIR=/absolute/path/to/data

# --- ML pipeline ---
# MODEL_MODE: segdiff (building segmentation + confirmation gate, default)
#             cd      (bi-temporal change-detection network, see MODEL_BACKEND)
MODEL_MODE=segdiff
# SEED_MODE: which detections seed SAM 2 refinement.
#   encroachment -> only building-on-former-vegetation (high precision)
#   all          -> also accept colour-change seeds
SEED_MODE=encroachment
# SAM 2 refinement uses the GPU when one is present. Inside Docker on
# macOS/Windows there is none, so it runs on CPU or falls back to a
# morphological closing — on an Apple Silicon machine run ada-ml on the HOST to
# reach the GPU (see ML_DEVICE below).
SAM_REFINE=true

# --- compute placement ---
# ML_DEVICE: auto | cuda | mps | cpu
#   auto -> CUDA if an NVIDIA card is present, else Apple Metal (MPS), else CPU.
#           Leave it here unless pinning a specific box.
#   mps  -> Apple Silicon GPU. Needs the default macOS arm64 wheels: plain
#           `torch` (a CUDA-index wheel has no Metal backend) and plain
#           `onnxruntime` >= 1.20 (it carries the CoreML EP; onnxruntime-gpu is
#           CUDA-only). Docker Desktop cannot pass a Mac GPU through, so this
#           only takes effect running ada-ml on the host.
ML_DEVICE=auto
# Turn a silent CPU fallback into a startup error. Worth setting true once the
# machine is known to work: a fallback costs ~10x and announces itself only as
# "analyses are slow".
REQUIRE_GPU=false
# GPU memory ceiling for ONE pipeline stage, and the host working-set ceiling
# that sizes the working grid.
#
# On NVIDIA these name two separate devices, so 4 + 18 is fine on a 6 GB card
# beside 32 GB of RAM. On APPLE SILICON they are two shares of ONE unified pool
# and must sum below what the machine will give a process — 6 + 12 on a 24 GB
# Mac, 10 + 24 on 48 GB. ada-ml warns at startup when they over-subscribe;
# over-subscribed means it pages mid-analysis instead of erroring.
GPU_MEMORY_LIMIT_GB=4.0
HOST_MEMORY_LIMIT_GB=18.0
# MODEL_BACKEND: auto | deep | feature_diff
#   auto         -> use "deep" if MODEL_WEIGHTS file exists, else feature_diff
#   deep         -> pretrained Siamese CD network (open-source weights)
#   feature_diff -> torchvision ResNet18 deep-feature differencing
MODEL_BACKEND=auto
# Optional — defaults to <repo>/data/weights/cd_model.pth if left unset.
# MODEL_WEIGHTS=/absolute/path/to/data/weights/cd_model.pth
CHIP_SIZE=256
CHIP_OVERLAP=64
CHANGE_THRESHOLD=0.5
MIN_CHANGE_AREA_M2=15.0

# Re-submit work interrupted by a restart. Set false when running with
# uvicorn --reload, true for Docker/production.
REQUEUE_STALE_ON_STARTUP=true

# Needed only to pull the gated SAM 3 weights; harmless when unset.
HF_TOKEN=
# Share the host's HuggingFace cache so a rebuild does not re-download weights.
# HF_CACHE_DIR=~/.cache/huggingface
