{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "include": ["services", "libs/python", "scripts", "infra/scripts"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/alembic/versions",
    "data",
    "apps",
    "docs"
  ],
  "executionEnvironments": [
    { "root": "services/api",       "extraPaths": ["libs/python/ada-core", "libs/python/ada-platform"] },
    { "root": "services/auth-otp",  "extraPaths": ["libs/python/ada-core", "libs/python/ada-platform"] },
    { "root": "services/ml-worker", "extraPaths": ["libs/python/ada-core", "libs/python/ada-platform"] },
    { "root": "services/notify",    "extraPaths": ["libs/python/ada-core", "libs/python/ada-platform"] },
    { "root": "libs/python/ada-core" },
    { "root": "libs/python/ada-platform" },
    { "root": "infra/scripts" }
  ]
}
